{
  "name": "homit-desktop",
  "productName": "HoMit",
  "version": "1.0.0",
  "description": "HoMit for Windows",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build": "node build.mjs",
    "dist": "node build.mjs && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "esbuild": "0.25.0",
    "typescript": "5.6.3"
  },
  "build": {
    "appId": "app.homit.desktop",
    "productName": "HoMit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "HoMit-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "HoMit",
        "schemes": [
          "homit",
          "waveroom"
        ]
      }
    ]
  }
}